#!/bin/bash
# hd-keeper - runs inside the Googlebook's Linux Terminal (Debian VM) as a
# systemd service.
#
# Uses this VM's own adb pairing to reach the Googlebook's Android side over
# Wireless debugging, and keeps android/hd-phone.sh running there (restarting
# it after a reboot, a crash, or when the script changes). Needs Wireless
# debugging on; Android turns it off at every reboot.
#
# Settings come from /etc/default/hd-keeper (written by install.sh):
#   HD_HOST   Android's IP as seen from the VM (also tries the VM's gateway)
#   HD_MODEL  ro.product.model of the Android device to manage

[ -f /etc/default/hd-keeper ] && . /etc/default/hd-keeper
MODEL=${HD_MODEL:-Lenovo Googlebook 15}
SCRIPT=/usr/local/share/hd-keeper/hd-phone.sh
STATE=/var/lib/hd-keeper
REMOTE=/data/local/tmp/hd-phone.sh

# The keeper has its own adb pairing key and its own private adb server, so nothing it does (its
# connects, its port search, its restarts) ever touches the Terminal's normal adb server or the
# pairing of any other tool. adb reads its key from $HOME/.android, so HOME points at the keeper's
# own folder for every adb call, and the private server listens on its own port.
export HOME=$STATE/adbhome
export ANDROID_ADB_SERVER_PORT=${HD_ADB_PORT:-5040}
KEYNAME=HomeDepotPhoneMode@googlebook

log() { echo "$(date '+%F %T') $*"; }

# hd-keeper pair CODE IP:PAIRPORT
# Pairs the keeper's own key once (Wireless debugging > Pair device with pairing code).
if [ "${1:-}" = pair ]; then
  code=${2:-}; paddr=${3:-}
  if [ -z "$code" ] || [ -z "$paddr" ]; then
    echo "Usage: hd-keeper pair CODE IP:PAIRPORT"
    echo "On the Googlebook: Settings > System > Developer options > Wireless debugging >"
    echo "'Pair device with pairing code', and keep that dialog open."
    exit 2
  fi
  mkdir -p "$HOME/.android" && chmod 700 "$HOME" "$HOME/.android"
  if [ ! -f "$HOME/.android/adbkey" ]; then
    timeout 30 adb keygen "$HOME/.android/adbkey" > /dev/null 2>&1
    echo "$(awk '{print $1}' "$HOME/.android/adbkey.pub") $KEYNAME" > "$HOME/.android/adbkey.pub"
  fi
  result=$(timeout 40 adb pair "$paddr" "$code" 2>&1)
  echo "$result"
  case "$result" in *"Successfully paired"*) ;; *) echo "Pairing failed, so nothing changed. Try again with a fresh code."; exit 1;; esac
  # Stop the private server this command started, so the service starts its own.
  timeout 10 adb kill-server > /dev/null 2>&1
  echo "Paired. The keeper connects on its own within a minute."
  exit 0
fi

# Prints the adb serial of the managed device if adb is connected to it.
connected() {
  local d
  for d in $(timeout 10 adb devices | awk 'NR > 1 && $2 == "device" {print $1}'); do
    [ "$(timeout 10 adb -s "$d" shell getprop ro.product.model 2>/dev/null | tr -d '\r')" = "$MODEL" ] \
      && { echo "$d"; return 0; }
  done
  return 1
}

hosts() {
  { cat "$STATE/host" 2>/dev/null; echo "$HD_HOST"; ip route | awk '/^default/ {print $3}'; } \
    | awk 'NF && !seen[$0]++'
}

# The Wireless debugging port changes whenever it is switched on, so scan for
# it and try each open port.
find_and_connect() {
  local h p d
  for h in $(hosts); do
    for p in $(timeout 60 nc -z -v -n -w 1 "$h" 32768-60999 2>&1 \
               | grep -oE '([0-9]+) port \[|\] ([0-9]+) \(.*open' | grep -oE '[0-9]+' ); do
      if timeout 10 adb connect "$h:$p" 2>/dev/null | grep -q '^connected\|already connected'; then
        d="$h:$p"
        if [ "$(timeout 10 adb -s "$d" shell getprop ro.product.model 2>/dev/null | tr -d '\r')" = "$MODEL" ]; then
          echo "$h" > "$STATE/host"
          echo "$d"; return 0
        fi
        adb disconnect "$d" > /dev/null 2>&1
      fi
    done
  done
  return 1
}

# Starts the watcher on Android unless the current version is already running.
ensure_watcher() {
  local d=$1 want have alive
  want=$(sha256sum < "$SCRIPT" | cut -c1-64)
  have=$(timeout 15 adb -s "$d" shell "sha256sum $REMOTE 2>/dev/null" | cut -c1-64)
  # "yes" when the watcher runs and its heartbeat is under 2 minutes old, "stale" when it runs
  # but has stopped looping (a hung watcher is restarted like a missing one).
  alive=$(timeout 15 adb -s "$d" shell 'p=$(cat /data/local/tmp/hd-phone.pid 2>/dev/null)
    b=$(cat /data/local/tmp/hd-phone.beat 2>/dev/null)
    if [ -n "$p" ] && grep -q hd-phone /proc/$p/cmdline 2>/dev/null; then
      case "$b" in ""|*[!0-9]*) echo stale;; *) [ $(( $(date +%s) - b )) -lt 120 ] && echo yes || echo stale;; esac
    fi' | tr -d '\r')
  [ "$alive" = yes ] && [ "$want" = "$have" ] && return 0
  [ "$alive" = stale ] && [ "$want" = "$have" ] && log "the watcher stopped responding; restarting it"
  timeout 30 adb -s "$d" push "$SCRIPT" "$REMOTE" > /dev/null || return 1
  timeout 15 adb -s "$d" shell 'p=$(cat /data/local/tmp/hd-phone.pid 2>/dev/null)
    [ -n "$p" ] && grep -q hd-phone /proc/$p/cmdline 2>/dev/null && kill $p
    setsid nohup sh /data/local/tmp/hd-phone.sh > /dev/null 2>&1 < /dev/null &' > /dev/null
  log "watcher started on $d"
}

mkdir -p "$STATE"
log "hd-keeper started (model: $MODEL, own adb server on port $ANDROID_ADB_SERVER_PORT)"
[ -f "$HOME/.android/adbkey" ] || log "the keeper's own key is not paired yet: run  hd-keeper pair CODE IP:PAIRPORT"

# Watchdog: the loop below writes a heartbeat on every pass. If it ever stops for 20 minutes
# (far longer than the slowest normal pass, a full port search), the keeper ends itself and
# systemd starts it again. The keeper holds no locks or device state, so nothing is left behind.
date +%s > "$STATE/beat"
main=$$
(
  while sleep 60; do
    kill -0 "$main" 2>/dev/null || exit 0
    b=$(cat "$STATE/beat" 2>/dev/null)
    case "$b" in ""|*[!0-9]*) b=0;; esac
    if [ $(( $(date +%s) - b )) -gt 1200 ]; then
      log "watchdog: the keeper stopped for 20 minutes; restarting it"
      timeout 10 adb kill-server > /dev/null 2>&1   # only the keeper's own private server
      kill -TERM "$main" 2>/dev/null; sleep 5; kill -KILL "$main" 2>/dev/null
      exit 0
    fi
  done
) &

last_scan=0
while true; do
  date +%s > "$STATE/beat"
  d=$(connected)
  # Port scans are cheap but not free: at most one every 2 minutes.
  if [ -z "$d" ] && [ $(( $(date +%s) - last_scan )) -ge 120 ]; then
    last_scan=$(date +%s)
    d=$(find_and_connect)
    [ -n "$d" ] && log "connected to $d"
  fi
  [ -n "$d" ] && ensure_watcher "$d"
  sleep 30
done
